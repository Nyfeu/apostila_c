\begin{Verbatim}[commandchars=\\\{\}]
\PYGZdl{}\PYG{+w}{ }git\PYG{+w}{ }branch\PYG{+w}{                       }\PYG{c+c1}{\PYGZsh{} lista as branches existentes}
\PYGZdl{}\PYG{+w}{ }git\PYG{+w}{ }checkout\PYG{+w}{ }\PYGZhy{}b\PYG{+w}{ }feature/wifi\PYG{+w}{     }\PYG{c+c1}{\PYGZsh{} cria e ja muda para a nova branch}
