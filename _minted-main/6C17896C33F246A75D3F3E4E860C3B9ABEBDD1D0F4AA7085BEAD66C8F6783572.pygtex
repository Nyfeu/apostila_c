\PYG{c+cp}{\PYGZsh{}include}\PYG{+w}{ }\PYG{c+cpf}{\PYGZlt{}esp\PYGZus{}task\PYGZus{}wdt.h\PYGZgt{}}

\PYG{c+cp}{\PYGZsh{}define WDT\PYGZus{}TIMEOUT 5   }\PYG{c+c1}{// segundos ate o reset, caso nao seja alimentado}

\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{setup}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{Serial}\PYG{p}{.}\PYG{n}{begin}\PYG{p}{(}\PYG{l+m+mi}{115200}\PYG{p}{);}

\PYG{+w}{    }\PYG{n}{esp\PYGZus{}task\PYGZus{}wdt\PYGZus{}init}\PYG{p}{(}\PYG{n}{WDT\PYGZus{}TIMEOUT}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nb}{true}\PYG{p}{);}\PYG{+w}{   }\PYG{c+c1}{// true: reinicia o chip ao vencer}
\PYG{+w}{    }\PYG{n}{esp\PYGZus{}task\PYGZus{}wdt\PYGZus{}add}\PYG{p}{(}\PYG{n+nb}{NULL}\PYG{p}{);}\PYG{+w}{                 }\PYG{c+c1}{// registra a tarefa de loop() no watchdog}

\PYG{+w}{    }\PYG{n}{Serial}\PYG{p}{.}\PYG{n}{println}\PYG{p}{(}\PYG{l+s}{\PYGZdq{}Watchdog configurado. Sistema iniciado.\PYGZdq{}}\PYG{p}{);}
\PYG{p}{\PYGZcb{}}

\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{loop}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{c+c1}{// ... leitura de sensores, logica do programa, etc ...}

\PYG{+w}{    }\PYG{n}{Serial}\PYG{p}{.}\PYG{n}{println}\PYG{p}{(}\PYG{l+s}{\PYGZdq{}Laco em execucao normal.\PYGZdq{}}\PYG{p}{);}
\PYG{+w}{    }\PYG{n}{esp\PYGZus{}task\PYGZus{}wdt\PYGZus{}reset}\PYG{p}{();}\PYG{+w}{   }\PYG{c+c1}{// \PYGZdq{}alimenta\PYGZdq{} o watchdog: avisa que o laco esta vivo}

\PYG{+w}{    }\PYG{n}{delay}\PYG{p}{(}\PYG{l+m+mi}{1000}\PYG{p}{);}
